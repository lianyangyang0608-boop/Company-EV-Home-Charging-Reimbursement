blueprint:
  name: Company EV Home Charging Reimbursement
  description: >
    Calculate company EV home-charging energy and reimbursement
    using ecoMain energy metering. Supports fixed electricity price
    or a dynamic price sensor such as Nord Pool.
  domain: automation

  input:
    power_sensor:
      name: Charging power sensor
      description: Select the ecoMain channel real-time power sensor.
      selector:
        entity:
          domain: sensor

    energy_sensor:
      name: Charging energy sensor
      description: Select the cumulative energy sensor of the same ecoMain channel.
      selector:
        entity:
          domain: sensor

    price_mode:
      name: Electricity price mode
      default: fixed
      selector:
        select:
          options:
            - label: Fixed electricity price
              value: fixed
            - label: Dynamic price sensor / Nord Pool
              value: dynamic

    fixed_price:
      name: Fixed electricity price
      description: Used only in Fixed mode. Unit should be currency/kWh.
      default: 0.30
      selector:
        number:
          min: 0
          max: 5
          step: 0.001
          mode: box

    dynamic_price_sensor:
      name: Dynamic electricity price sensor
      description: >
        Used only in Dynamic mode. Select your Nord Pool price entity
        or another sensor whose state is the current price per kWh.
      default: []
      selector:
        entity:
          domain: sensor

    start_power:
      name: Charging start threshold
      default: 500
      selector:
        number:
          min: 0
          max: 10000
          step: 10
          unit_of_measurement: W

    stop_power:
      name: Charging stop threshold
      default: 100
      selector:
        number:
          min: 0
          max: 5000
          step: 10
          unit_of_measurement: W

    start_delay:
      name: Start confirmation
      default:
        minutes: 2
      selector:
        duration:

    stop_delay:
      name: Stop confirmation
      default:
        minutes: 5
      selector:
        duration:

mode: single
max_exceeded: silent

variables:
  power_entity: !input power_sensor
  energy_entity: !input energy_sensor
  price_mode_var: !input price_mode
  fixed_price_var: !input fixed_price
  dynamic_price_entity: !input dynamic_price_sensor
  stop_power_var: !input stop_power

trigger:
  - platform: numeric_state
    entity_id: !input power_sensor
    above: !input start_power
    for: !input start_delay

action:
  - variables:
      session_start_wh: "{{ states(energy_entity) | float(0) }}"
      interval_start_wh: "{{ states(energy_entity) | float(0) }}"
      accumulated_cost: 0
      current_rate: >
        {% if price_mode_var == 'dynamic' %}
          {{ states(dynamic_price_entity) | float(0) }}
        {% else %}
          {{ fixed_price_var | float(0) }}
        {% endif %}

  - choose:

      # FIXED PRICE
      - conditions:
          - condition: template
            value_template: "{{ price_mode_var == 'fixed' }}"
        sequence:

          - wait_for_trigger:
              - platform: numeric_state
                entity_id: !input power_sensor
                below: !input stop_power
                for: !input stop_delay

          - variables:
              end_wh: "{{ states(energy_entity) | float(0) }}"
              session_kwh: >
                {{ ([0,
                    ((states(energy_entity) | float(0))
                    - (session_start_wh | float(0))) / 1000]
                    | max) }}
              session_cost: >
                {{ ([0,
                    ((states(energy_entity) | float(0))
                    - (session_start_wh | float(0))) / 1000]
                    | max)
                    * (fixed_price_var | float(0)) }}

          - service: logbook.log
            data:
              name: Company EV Charging
              message: >
                Charging finished.
                Energy: {{ session_kwh | round(3) }} kWh.
                Cost: {{ session_cost | round(2) }}.
                Fixed rate: {{ fixed_price_var }} /kWh.

      # DYNAMIC PRICE
      - conditions:
          - condition: template
            value_template: "{{ price_mode_var == 'dynamic' }}"
        sequence:

          - repeat:
              sequence:

                - wait_for_trigger:

                    - platform: state
                      entity_id: !input dynamic_price_sensor
                      id: price_changed

                    - platform: numeric_state
                      entity_id: !input power_sensor
                      below: !input stop_power
                      for: !input stop_delay
                      id: charging_stopped

                - variables:
                    current_wh: "{{ states(energy_entity) | float(0) }}"

                    interval_kwh: >
                      {{ ([0,
                          ((states(energy_entity) | float(0))
                          - (interval_start_wh | float(0))) / 1000]
                          | max) }}

                    interval_cost: >
                      {{ ([0,
                          ((states(energy_entity) | float(0))
                          - (interval_start_wh | float(0))) / 1000]
                          | max)
                          * (current_rate | float(0)) }}

                    accumulated_cost: >
                      {{ (accumulated_cost | float(0))
                         + (interval_cost | float(0)) }}

                    interval_start_wh: >
                      {{ states(energy_entity) | float(0) }}

                    current_rate: >
                      {% if wait.trigger.id == 'price_changed' %}
                        {{ states(dynamic_price_entity) | float(0) }}
                      {% else %}
                        {{ current_rate | float(0) }}
                      {% endif %}

              until:
                - condition: template
                  value_template: >
                    {{ wait.trigger.id == 'charging_stopped' }}

          - variables:
              session_kwh: >
                {{ ([0,
                    ((states(energy_entity) | float(0))
                    - (session_start_wh | float(0))) / 1000]
                    | max) }}

          - service: logbook.log
            data:
              name: Company EV Charging
              message: >
                Charging finished.
                Energy: {{ session_kwh | round(3) }} kWh.
                Dynamic electricity cost:
                {{ accumulated_cost | float(0) | round(2) }}.
