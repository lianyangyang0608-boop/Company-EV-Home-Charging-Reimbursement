blueprint:
  name: Company EV Home Charging Cost
  description: >
    Calculate accumulated EV home charging cost from a selected
    power sensor. Supports either a fixed electricity price or
    a dynamic electricity price sensor such as Nord Pool.
    Only one Number Helper is required for the accumulated cost.
  domain: automation

  input:
    power_sensor:
      name: EV Charging Power Sensor
      description: Select the ecoMain channel used for EV charging.
      selector:
        entity:
          filter:
            - domain: sensor
              device_class: power

    price_mode:
      name: Electricity Price Mode
      default: fixed
      selector:
        select:
          options:
            - label: Fixed Price
              value: fixed
            - label: Dynamic Price / Nord Pool
              value: dynamic

    fixed_price:
      name: Fixed Electricity Price
      description: >
        Electricity price per kWh. Used only when Fixed Price is selected.
      default: 0.30
      selector:
        number:
          min: 0
          max: 5
          step: 0.001
          mode: box

    dynamic_price_sensor:
      name: Dynamic Price Sensor
      description: >
        Select the current electricity price sensor, for example Nord Pool.
        Used only in Dynamic Price mode.
      default: []
      selector:
        entity:
          domain: sensor

    cost_output:
      name: Accumulated Charging Cost
      description: >
        Select the Number Helper used to store accumulated charging cost.
      selector:
        entity:
          domain: input_number

    start_power:
      name: Charging Start Threshold
      default: 500
      selector:
        number:
          min: 0
          max: 10000
          step: 10
          unit_of_measurement: W

    stop_power:
      name: Charging Stop Threshold
      default: 100
      selector:
        number:
          min: 0
          max: 5000
          step: 10
          unit_of_measurement: W

variables:
  power_entity: !input power_sensor
  price_mode_var: !input price_mode
  fixed_price_var: !input fixed_price
  dynamic_price_entity: !input dynamic_price_sensor
  cost_entity: !input cost_output
  stop_power_var: !input stop_power

trigger:
  - platform: numeric_state
    entity_id: !input power_sensor
    above: !input start_power
    for:
      seconds: 5

condition: []

action:

  # Charging session starts.
  - repeat:
      sequence:

        # Wait one minute before calculating the next cost increment.
        - delay:
            minutes: 1

        - variables:

            current_power_kw: >
              {{ (states(power_entity) | float(0)) / 1000 }}

            current_price: >
              {% if price_mode_var == 'dynamic' %}
                {{ states(dynamic_price_entity) | float(0) }}
              {% else %}
                {{ fixed_price_var | float(0) }}
              {% endif %}

            cost_increment: >
              {% set p = (states(power_entity) | float(0)) / 1000 %}
              {% if price_mode_var == 'dynamic' %}
                {% set price = states(dynamic_price_entity) | float(0) %}
              {% else %}
                {% set price = fixed_price_var | float(0) %}
              {% endif %}

              {{ p * price / 60 }}

        - action: input_number.set_value
          target:
            entity_id: !input cost_output
          data:
            value: >
              {{
                (
                  states(cost_entity) | float(0)
                  +
                  cost_increment | float(0)
                ) | round(3)
              }}

      until:
        - condition: template
          value_template: >
            {{ states(power_entity) | float(0) < stop_power_var | float(0) }}

mode: single
max_exceeded: silent
